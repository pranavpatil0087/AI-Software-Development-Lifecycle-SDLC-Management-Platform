# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sdlc_platform
DB_USERNAME=sdlc_user
DB_PASSWORD=sdlc_password

# JWT
JWT_SECRET=replace-with-a-long-random-base64-secret-min-256-bits
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# Mail (Mailtrap for dev, Resend for prod)
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=your-mailtrap-username
MAIL_PASSWORD=your-mailtrap-password
MAIL_FROM=no-reply@sdlcplatform.com

# Frontend / CORS
FRONTEND_BASE_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

# AI
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
